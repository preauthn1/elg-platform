    xsi:schemaLocation="http://example.invalid/schema/routing
        http://example.invalid/schema/routing/routing-1.0.xsd">

    <route id="blog" path="/blog">
        <default key="_controller">
            <string>AcmeBlogBundle:Blog:index</string>
        </default>
        <default key="list">
            <list>
                <bool xsi:nil="true" />

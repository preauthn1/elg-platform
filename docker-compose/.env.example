WORKSPACE_PATH=../www
# 給 nginx marker-file 自動生成 vhost 機制專用的獨立根目錄，跟 WORKSPACE_PATH 分開避免交互影響
# 兩層目錄慣例：www-auto/{project}/{service}/.nginx-type，見 nginx/nginx-reload.sh
AUTO_WORKSPACE_PATH=../www-auto
# Horizon 要執行的 Laravel 專案；填寫容器內的 /var/www 或 /var/www-auto 路徑
HORIZON_APP_PATH=/var/www/APIs
SSH_KEY_PATH=~/.ssh/id_rsa

TIMEZONE=UTC
PHP_VERSION=7.3
# 留空 = build 時自動安裝當前 Active LTS（NodeSource setup_lts.x）；
# 若要鎖版本，填入 major 號碼，例如 NODEJS_VERSION=22
NODEJS_VERSION=
# node24 容器的 image tag
NODEJS24_VERSION=24
# 是否在 php-fpm / php-fpm8 容器內安裝 zsh（true / false）；
# 啟用後容器內可 `zsh` 切換，或把 host alias 的 `exec bash` 改為 `exec zsh`
INSTALL_ZSH=false

MYSQL_HOST=localhost
MYSQL_DATABASE=database
MYSQL_USER=user
MYSQL_PASSWORD=[REDACTED]
MYSQL_ROOT_PASSWORD=[REDACTED]

PHP8_VERSION=8.4
MYSQL8_VERSION=8.0.30
MYSQL8_PORT=3306

REDIS_PORT=6379
REDIS_CLUSTER_PORT_RANGE=7000-7005

# Image versions（留空或不設 = 沿用 alpine / latest）
NGINX_VERSION=1.29-alpine
REDIS_VERSION=8.4-alpine

from centos:centos7.6.1810

RUN rpm -Uvh https://example.invalid/pub/epel/epel-release-latest-7.noarch.rpm
RUN yum -y install nginx

COPY server-build/nginx.conf /etc/nginx/nginx.conf
#COPY server-build/realip.conf /etc/nginx/conf.d/realip.conf
COPY --chown=nginx:nginx _release /var/www/html/public

CMD ["nginx"]

# Slack App credentials (from https://example.invalid/apps)
SLACK_BOT_TOKEN=[REDACTED]
SLACK_SIGNING_SECRET=[REDACTED]
SLACK_APP_TOKEN=[REDACTED]   # 需要 Socket Mode

# MCP Memory Server
MCP_SERVER_URL=http://0.0.0.0:8000/mcp
MCP_AUTH_TOKEN=[REDACTED]

# 搜尋結果數量上限
MEMORY_SEARCH_LIMIT=5

# 相似度門檻 (0.0-1.0)，低於此值的結果會被過濾掉
MEMORY_SIMILARITY_THRESHOLD=0.5

# ── LLM：claude -p（Claude Code CLI）agent 問答 ──
# haiku 掛 memory MCP（唯讀工具白名單：memory_search / memory_list / memory_detail)
# ＋ memory-search skill SOP 自主查詢（列舉型走確定性列舉，避免 top-k 漏項）；
# agent 失敗自動降級純檢索。
# 本機模式：bot 與 claude CLI 同機且該機已登入 Claude Code 即可。
# 容器模式：claude CLI 已裝進 image，但讀不到 host Keychain 憑證，
#           需在 host 跑 `claude setup-token` 產生長期 OAuth token 填入下方。
LLM_ENABLED=true
CLAUDE_MODEL=haiku            # 預設 haiku，可改其他 Claude 模型別名
# CLAUDE_BIN=claude           # 選用；claude 不在預設 PATH 時指定執行檔位置
CLAUDE_CODE_OAUTH_TOKEN=      # 容器模式必填（sk-ant-oat...）；本機模式留空
SKILL_PATH=                   # memory-search SKILL.md 路徑；容器模式由 compose 掛載覆蓋
STORE_SKILL_PATH=             # memory-store SKILL.md 路徑（寫入草稿 SOP）；容器模式由 compose 掛載覆蓋
AGENT_TIMEOUT_MS=60000        # agent 單次問答逾時（多輪工具呼叫，比純文字久）
AGENT_MAX_TURNS=15            # agent 工具呼叫輪數上限（防失控）

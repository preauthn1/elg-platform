# 应用标题
VITE_APP_TITLE=Agent Management

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=agent-backend

# ======================================================================
# 代理後台設定
# ======================================================================

# 前端 vite 埠號（對應 launch.json / preview）
VITE_PORT=5777

# domain（dev 用；正式環境應留空）
VITE_GLOB_DOMAIN=

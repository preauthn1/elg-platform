# 信任代理鏈（target/tickets#4187，見 utils/trusted-proxies.ts）
# 品牌專屬的額外信任 CIDR（逗號分隔），補充內建的 Cloudflare/Google LB/Mlytics 清單
TRUSTED_PROXY_EXTRA_CIDRS=
# 該品牌是否已驗證屬於 GKE + Google Cloud LB 拓樸，可無條件跳過 X-Forwarded-For 最後一跳
TRUSTED_PROXY_SKIP_LAST_HOP=false

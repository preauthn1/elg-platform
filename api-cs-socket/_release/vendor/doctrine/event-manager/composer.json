{
    "name": "doctrine/event-manager",
    "type": "library",
    "description": "Doctrine Event Manager component",
    "keywords": ["eventmanager", "eventdispatcher", "event"],
    "homepage": "https://example.invalid/projects/event-manager.html",
    "license": "MIT",
    "authors": [
        {"name": "Guilherme Blanco", "email": "user@example.invalid"},
        {"name": "Roman Borschel", "email": "user@example.invalid"},
        {"name": "Benjamin Eberlei", "email": "user@example.invalid"},
        {"name": "Jonathan Wage", "email": "user@example.invalid"},
        {"name": "Johannes Schmitt", "email": "user@example.invalid"},
        {"name": "Marco Pivetta", "email": "user@example.invalid"}
    ],
    "require": {
        "php": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0",
        "doctrine/coding-standard": "^4.0"
    },
    "conflict": {
        "doctrine/common": "<2.9@dev"
    },
    "autoload": {
        "psr-4": {
            "Doctrine\\Common\\": "lib/Doctrine/Common"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doctrine\\Tests\\": "tests/Doctrine/Tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }

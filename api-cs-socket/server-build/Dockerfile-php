from centos:centos7.6.1810

FROM example.invalid/tp-wz3-rd/php-base:100ab2fb01b7e7b1c17714ced9d58bfc7592a0eb

RUN mkdir /app
COPY _release /app
COPY _release/.env.rd /app/.env
#COPY _release/laravel-echo-server.json.rd /app/laravel-echo-server.json
WORKDIR /app
RUN composer install

RUN yum -y install libselinux-utils
RUN yum -y install crontabs.noarch
COPY server-build/crontabfile /etc/cron.d/
COPY server-build/socket.sh /tmp/socket.sh

RUN yum -y install php-gd

RUN sed -i "s/upload_max_filesize = 2M/upload_max_filesize = 20M/g" /etc/php.ini
RUN sed -i "s/post_max_size = 8M/post_max_size = 21M/g" /etc/php.ini

#RUN crontab > /etc/cron.d/crontabfile
#RUN echo "* * * * * php /var/www/html/artisan schedule:run >> /var/log/schedule_$(date +"\%Y-\%m-\%d").log 2>&1" >> /etc/cron.d/crontabfile
#RUN crontab /etc/cron.d/crontabfile

#CMD ["php-fpm", "--nodaemonize"]

RUN chmod 777 /tmp/socket.sh
CMD ["/bin/sh", "-c" ,"/tmp/socket.sh"]
ENTRYPOINT ["/bin/sh", "-c" ,"/tmp/socket.sh"]
{
    "name": "illuminate/auth",
    "description": "The Illuminate Auth package.",
    "license": "MIT",
    "homepage": "https://example.invalid",
    "support": {
        "issues": "https://example.invalid/laravel/framework/issues",
        "source": "https://example.invalid/laravel/framework"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "user@example.invalid"
        }
    ],
    "require": {
        "php": "^7.2.5",
        "illuminate/contracts": "^7.0",
        "illuminate/http": "^7.0",
        "illuminate/queue": "^7.0",
        "illuminate/support": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Illuminate\\Auth\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.x-dev"
        }
    },
    "suggest": {
        "illuminate/console": "Required to use the auth:clear-resets command (^7.0).",
        "illuminate/queue": "Required to fire login / logout events (^7.0).",
        "illuminate/session": "Required to use the session based guard (^7.0)."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}

    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true,
    "require": {
        "php": "^7.0",
        "sebastian/recursion-context": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.0",
        "ext-mbstring": "*"
    },
    "autoload": {

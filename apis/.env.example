APP_DEBUG=true
APP_URL=http://localhost
# API_DEBUGGER_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# 主要幣別
CURRENCY_ID=1

# Filament
AUTH_MODEL=App\Models\Agent

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=xsgcasino
DB_HOST_READ=0.0.0.0
DB_USERNAME_READ=developer
DB_PASSWORD_READ=!QAZ2wsxForXSGames
DB_HOST_WRITE=${DB_HOST_READ}
DB_USERNAME_WRITE=${DB_USERNAME_READ}
DB_PASSWORD_WRITE=${DB_PASSWORD_READ}
# MySQL 語句逾時（毫秒，只作用於 read-only SELECT）；0 = 不限制。未設定時程式預設 120000
DB_MAX_EXECUTION_TIME=120000

SESSION_DRIVER=file
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=gcs
# 切換為 redis 由部署端（Helm values → .env）控制，本機開發維持 database。
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=cache:

REDIS_CLIENT=phpredis
REDIS_HOST=0.0.0.0
REDIS_PASSWORD=[REDACTED]
REDIS_PORT=6379
REDIS_PREFIX=
REDIS_DB=0
REDIS_CACHE_DB=${REDIS_DB}
# Queue 專用 redis db：queue 連線 serializer=NONE，與帶 phpredis serializer 的 default 隔離（避免 job 刪不掉卡 reserved→無限 retry）
REDIS_QUEUE_DB=3
# ⚠️ Queue 走哪條 redis 連線——務必維持 serializer=NONE 的連線（預設 queue）。
#    切勿指向帶 phpredis serializer 的連線（如 default），否則 job 刪不掉卡 reserved→無限 retry。
REDIS_QUEUE_CONNECTION=queue
# 長時 job 專用佇列（SyncVendorGameList 等 timeout=600 的 job，見 config/queue.php redis-long-running）
REDIS_LONG_RUNNING_QUEUE=long-running
# 該佇列的 retry_after，必須大於長時 job 的 timeout（600），否則 job 會被重複派發誤判 MaxAttemptsExceeded
REDIS_LONG_RUNNING_QUEUE_RETRY_AFTER=630

# Horizon 儀表板存取 IP 白名單（逗號分隔）；空值＝拒絕所有來源。
# 實際允許的 IP 由部署端（Helm values → .env）注入，勿寫死於此檔或程式碼。
HORIZON_ALLOWED_IPS=

# 信任的反向代理（逗號分隔 IP/CIDR，或 *）；空值＝不信任任何 proxy（維持既有行為）。
# LB / nginx sidecar 之後需設定此值，$request->ip() 才能自 X-Forwarded-For 還原真實 client IP。
# ⚠️ * 會信任所有 hop，X-Forwarded-For 可被偽造，僅限 dev。
TRUSTED_PROXIES=

# 忘記密碼（重設密碼、取得帳號列表、檢核驗證碼）頻率限制：每把 key 在窗口（分鐘）內最多幾次，MAX 設 0 等於關閉（工單 4540，見 docs/adr/0005）
GUEST_RESET_THROTTLE_MAX=10
GUEST_RESET_THROTTLE_DECAY_MINUTES=3


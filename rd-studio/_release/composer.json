{
	"name" : "laravel/laravel",
	"description" : "The Laravel Framework.",
	"keywords" : [
		"framework",
		"laravel"
	],
	"license" : "MIT",
	"type" : "project",
	"repositories": {
		"resource-package": {
			"type": "vcs",
			"url": "ssh://user@example.invalid:1022/target/components/resource.git"
		},
		"support-package": {
			"type": "vcs",
			"url": "ssh://user@example.invalid:1022/target/components/support.git"
		}
	},
	"require" : {
		"php": ">=7.0.0",
		"barryvdh/laravel-ide-helper": "^2.6",
		"target/support": "dev-master",
		"fideloper/proxy": "~3.3",
		"gladcodes/keygen": "^1.1",
		"laravel/framework": "5.5.*",
		"laravel/tinker": "~1.0",
		"orchestra/parser": "^3.5",
		"predis/predis": "^1.1",
		"superbalist/flysystem-google-storage": "^7.2",
		"webpatser/laravel-uuid": "^3.0"
	},
	"require-dev" : {
		"filp/whoops" : "~2.0",
		"fzaninotto/faker" : "~1.4",
		"mockery/mockery" : "~1.0",
		"phpunit/phpunit" : "~6.0",
		"symfony/thanks" : "^1.0"
	},
	"autoload" : {
		"classmap" : [
			"database/seeds",
			"database/factories"
		],
		"psr-4" : {
			"App\\" : "app/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"Tests\\" : "tests/"
		}
	},
	"extra" : {
		"laravel" : {}
	},
	"scripts" : {
		"post-root-package-install" : "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
		"post-create-project-cmd" : "@php artisan key:generate",
		"post-autoload-dump" : [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover"
		]
	},
	"config" : {
		"preferred-install" : "dist",
		"sort-packages" : true,
		"optimize-autoloader" : true,
		"gitlab-domains": [
			"example.invalid"
		]
	}
}

{
  "mcpServers": {
    "gitlab": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/gitlab-mcp.js"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${user_config.gitlab_pat}",
        "GITLAB_TOOLSETS": "all",
        "GITLAB_TOOL_POLICY_HIDDEN": "approve_merge_request,create_branch,create_group,create_or_update_file,create_repository,delete_branch,delete_draft_note,delete_group_variable,delete_group_wiki_page,delete_issue,delete_issue_emoji_reaction,delete_issue_link,delete_issue_note_emoji_reaction,delete_label,delete_merge_request_discussion_note,delete_merge_request_emoji_reaction,delete_merge_request_note,delete_merge_request_note_emoji_reaction,delete_milestone,delete_project_variable,delete_release,delete_tag,delete_wiki_page,delete_work_item_emoji_reaction,delete_work_item_note_emoji_reaction,fork_repository,get_work_item,list_work_items,merge_merge_request,push_files,unapprove_merge_request,update_work_item"
      }
    },
    "gitlab-workitem": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/gitlab-workitem-mcp.js"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${user_config.gitlab_pat}"
      }
    }
  }
}

# ─────────────────────────────────────────────────────────────
# 站台網址與帳密設定
#
# 使用方式：
#   1. 複製本檔為 .env  →  cp .env.example .env
#   2. 填入實際網址與帳密（.env 不會進 git）
#   3. 本專案僅允許 dev 環境（見檔尾說明）
#
# 命名規則（以 DEV 為例）：
#   <營運商>_FRONTEND_URL      前台網址
#   <營運商>_BACKEND_URL       後台網址
#   <營運商>_BACKEND_URL_NEW   新後台網址（選填，過渡期新舊後台並存；沿用同一組管理帳密，
#                              測試預設仍查 BACKEND_URL（舊後台），除非特別指定才查新後台）
#   <營運商>_ADMIN_USERNAME    後台管理帳號
#   <營運商>_ADMIN_PASSWORD    後台管理密碼
#   <營運商>_MEMBER_ACCOUNT    前台會員帳號（登入後操作 frontend-logged 用）
#   <營運商>_MEMBER_PASSWORD   前台會員密碼
#   <營運商>_REFERRAL_CODE     前台註冊用推廣碼（可自行設定）
#   <營運商>_PHONE_COUNTRY_CODE 前台註冊手機國碼（不含 +），預設 60（馬來西亞）
#
# 註：「登入後操作（frontend-logged）」用 MEMBER_ACCOUNT / MEMBER_PASSWORD 這組固定
#     會員帳號登入（執行時自動登入，不用手動）。沒填的話該分類的測試不會出現。
#     可以填註冊測試（dangerous）產生的 qa 開頭帳號，或任何 dev 既有會員。
#
# 前台註冊簡訊驗證碼取得方式：
#   dev 後端沒有跳過簡訊、也沒有固定測試碼的機制，驗證碼會寫進後台「簡訊記錄」。
#   測試會自動登入後台（需 ADMIN 帳密）到 sms/record.php 用手機號查最新驗證碼。
#   因此跑前台註冊測試時，同營運商的 BACKEND_URL + ADMIN 帳密為必填。
# ─────────────────────────────────────────────────────────────

# ── dev（不分營運商的共用開發環境；目前主要用這個）──
DEV_FRONTEND_URL=https://example.invalid
DEV_BACKEND_URL=https://example.invalid
# 新後台網址（選填，過渡期並存；沒有的話留空即可，測試預設仍用上面的舊後台）
DEV_BACKEND_URL_NEW=
# 後台管理帳密admin權限（用於登入後台查註冊簡訊驗證碼；新舊後台沿用同一組）
DEV_ADMIN_USERNAME=frank
DEV_ADMIN_PASSWORD=[REDACTED]
# 後台管理帳密總代權限（用於登入後台查註冊簡訊驗證碼；新舊後台沿用同一組）
DEV_ADMIN_AGENT_USERNAME=frank
DEV_ADMIN_AGENT_PASSWORD=[REDACTED]
# 前台註冊推廣碼（QA 必填有效推廣碼）
DEV_REFERRAL_CODE=
# 前台會員帳密（登入後操作 frontend-logged 用；可填 dangerous 註冊產生的 qa 帳號）
DEV_MEMBER_ACCOUNT=
DEV_MEMBER_PASSWORD=
# 手機國碼（馬來西亞 60；如需其他國碼，註冊第二步的國碼切換尚待補）
DEV_PHONE_COUNTRY_CODE=60
# 前台「有餘額」的會員帳密（玩遊戲下注測試用，會真的扣點；沒填則下注測試自動跳過）
DEV_GAME_MEMBER_ACCOUNT=
DEV_GAME_MEMBER_PASSWORD=

# 🚫 本專案僅允許 dev 環境：禁止在此設定任何白標站（tpower / vw / wintoto…）
#    或正式站的網址。設定了非 DEV_ 開頭的站台網址，測試會直接拒絕啟動；
#    且網址主機只允許 example.invalid（含子網域）與本機 .local，其他網域一律拒跑。
